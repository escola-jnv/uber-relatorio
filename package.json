{
  "name": "uber-relatorio",
  "private": true,
  "type": "module",
  "description": "App de relatório e controle de corridas Uber",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node test/test-server.js && node test/test-modules.js && node test/test-odo.js && node test/test-pausas.js && node test/test-autonomia.js",
    "build:css": "tailwindcss -i src/styles.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i src/styles.css -o public/css/app.css --watch",
    "build": "npm run build:css"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/cli": "^4.3.4",
    "tailwindcss": "^4.3.4"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  }
}
