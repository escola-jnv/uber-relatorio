# ========================================================
# Configurações do Ambiente Local - Corridas Uber
# ========================================================

# Porta do servidor HTTP local (padrão: 3000)
PORT=3000

# --------------------------------------------------------
# Supabase (Banco de dados)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
# --------------------------------------------------------
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# --------------------------------------------------------
# Token de Acesso (Opcional, mas recomendado)
# Se preenchido, exige ?token=SEU_TOKEN ou header 'x-token'
# Se vazio, permite acesso livre em ambiente local
# --------------------------------------------------------
TOKEN=

# --------------------------------------------------------
# WhatsApp Webhook (Opcional)
# --------------------------------------------------------
# Nome do grupo padrão (Z-API / busca por nome):
WA_GROUP_NAME=Uber

# ID do grupo no WhatsApp (Evolution API / WAHA - ex.: 1203630...@g.us):
WA_GROUP_ID=
